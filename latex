\put(65.424,-64.47998){\fontsize{21.96}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}Chapter 1 – Introduction }
\put(65.424,-99.78003){\fontsize{15.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(65.424,-129.54){\fontsize{15.96}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}1.1 Background }
\put(65.424,-157.5){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Communication is one of the most essential parts of human life. However, }
\put(65.424,-183.42){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}people who are hearing or speech impaired often face great challenges in }
\put(65.424,-209.46){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}interacting with others who do not understand sign language. This }
\put(65.424,-235.5){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}communication gap limits their opportunities in education, workplaces, }
\put(65.424,-261.57){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}and daily life. }
\put(65.424,-287.61){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The Sign Language to Text Language Conversion System aims to bridge }
\put(65.424,-313.65){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}this gap using artificial intelligence (AI) and computer vision. The system }
\put(65.424,-339.69){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}captures hand gestures made by a user through a webcam, processes them }
\put(65.424,-365.73){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}using OpenCV and Mediapipe, and converts them into corresponding text }
\put(65.424,-391.77){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}using a machine learning model. }
\put(65.424,-417.69){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}This digital solution removes the need for an interpreter, enabling }
\put(65.424,-443.75){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}smoother and more natural communication between the hearing-impaired }
\put(65.424,-469.79){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}community and others. It provides a real-time, reliable, and user-friendly }
\put(65.424,-495.83){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}platform that promotes inclusivity and accessibility through technology. }
\put(65.424,-521.87){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(65.424,-547.91){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}1.2 Motivation }
\put(65.424,-573.95){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The motivation for developing this project comes from observing the }
\put(65.424,-599.99){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}struggles of people who depend on sign language to express themselves. }
\put(65.424,-625.94){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}In many public spaces—such as hospitals, schools, and government }
\put(65.424,-651.98){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}offices—lack of understanding between hearing and non-hearing }
\put(65.424,-678.02){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}individuals leads to frustration and miscommunication. }
\put(65.424,-704.06){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}With rapid growth in AI, computer vision, and deep learning technologies, }
\put(65.424,-730.1){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}it has now become possible to design systems that can “see” and }
\put(65.424,-756.136){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}“understand” gestures in real time. This inspired us to create a system that }
\put(65.424,-782.176){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}can translate sign gestures into readable text automatically. }
\end{picture}
