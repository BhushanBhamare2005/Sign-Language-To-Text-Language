\put(285.07,-809.8){\fontsize{11.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-809.32){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-97.14001){\fontsize{21.96}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}Abstract }
\put(69.984,-127.62){\fontsize{24.96}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791} }
\put(69.984,-148.26){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The Sign Language to Text Language Conversion System is an artificial }
\put(69.984,-164.34){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}intelligence–based application developed to bridge the communication gap }
\put(69.984,-180.42){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}between the hearing-impaired and the general public. It replaces traditional }
\put(69.984,-196.62){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}communication barriers by recognizing sign language gestures and converting }
\put(69.984,-212.7){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}them into readable text in real time. Using technologies such as Python, OpenCV, }
\put(69.984,-228.78){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Mediapipe, and TensorFlow, the system captures hand gestures through a webcam, }
\put(69.984,-244.86){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}processes them using machine learning algorithms, and displays the corresponding }
\put(69.984,-260.97){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}text output. }
\put(69.984,-278.97){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}This project provides key features such as real-time gesture detection, high-}
\put(69.984,-295.17){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}accuracy recognition, and a user-friendly interface that allows seamless interaction }
\put(69.984,-311.25){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}between users. The system can help in classrooms, workplaces, hospitals, and }
\put(69.984,-327.33){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}public spaces to support inclusive communication. By automating gesture }
\put(69.984,-343.41){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}recognition through deep learning, the project not only saves time but also }
\put(69.984,-359.49){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}promotes accessibility, inclusivity, and equal communication opportunities for }
\put(69.984,-375.57){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}everyone. Ultimately, the Sign Language to Text Language Conversion System }
\put(69.984,-391.77){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}contributes to creating a more connected and understanding society through the }
\put(69.984,-407.85){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}power of AI. }
