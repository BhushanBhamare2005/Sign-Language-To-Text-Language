\put(282.07,-809.8){\fontsize{11.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-809.32){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(83.424,-57.03998){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• T = Set of corresponding text outputs }
\put(83.424,-73.12){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• f(S) → T = Function learned by the CNN model }
\put(69.984,-89.21997){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}If Si represents a specific sign, then the model output is: }
