\put(69.984,-266.73){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}5.3 Objective Function }
\put(69.984,-282.81){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The main objective of this system is to maximize the accuracy and speed of gesture }
\put(69.984,-298.89){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}recognition while minimizing processing errors. }
\put(69.984,-314.97){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}                                }
\put(69.984,-331.05){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Maximize A = (R – E) }
\put(69.984,-347.25){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Where, }
\put(83.424,-363.33){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• A = Overall system accuracy }
\put(83.424,-379.41){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• R = Recognition rate (correctly predicted gestures) }
\put(83.424,-395.49){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• E = Error rate (misclassified gestures) }
\put(69.984,-411.57){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Subject to: }
\put(83.424,-427.65){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Each gesture must belong to one class only. }
\put(83.424,-443.87){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Lighting and background conditions should be within acceptable limits. }
\put(83.424,-459.95){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Input gesture must be visible to the camera for correct detection. }
\put(69.984,-476.03){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Thus, by optimizing accuracy (A), the system achieves faster and more reliable }
\put(69.984,-492.11){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}gesture-to-text conversion. }
