\put(65.424,-57.03998){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Our goal is to help make communication equal and accessible for }
\put(65.424,-83.09998){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}everyone, ensuring that no one feels left out due to speech or hearing }
