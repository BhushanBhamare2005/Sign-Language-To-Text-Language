\put(69.984,-102.54){\fontsize{15.96}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}6.1 Conclusion }
\put(69.984,-119.1){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The Sign Language to Text Language Conversion System successfully }
\put(69.984,-135.3){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}demonstrates how artificial intelligence and computer vision can bridge the }
\put(69.984,-151.38){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}communication gap between hearing-impaired and non-hearing individuals. }
\put(69.984,-167.46){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The system captures hand gestures through a webcam, processes them using }
\put(69.984,-183.54){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Mediapipe and CNN algorithms, and displays corresponding text output in real }
\put(69.984,-199.62){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}time. This eliminates the need for human interpreters and provides a fast, inclusive, }
\put(69.984,-215.7){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}and automated communication method. }
\put(69.984,-231.9){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Through real-time gesture detection, accuracy, and an easy-to-use interface, the }
\put(69.984,-247.98){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}system enhances accessibility and promotes inclusivity. Overall, this project shows }
\put(69.984,-264.09){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}how AI can make a meaningful social impact by transforming sign language into a }
\put(69.984,-280.17){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}universally understandable form. }
\put(69.984,-296.49){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
