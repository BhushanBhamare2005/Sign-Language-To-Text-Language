\put(282.07,-809.8){\fontsize{11.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-809.32){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-64.47998){\fontsize{21.96}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791} }
\put(69.984,-89.82001){\fontsize{21.96}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}Chapter 3 – Problem Definition and Scope }
\put(69.984,-115.02){\fontsize{21.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-132.9){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}3.1 Problem Statement }
\put(69.984,-149.1){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Communication between hearing-impaired individuals and people who do not }
\put(69.984,-165.18){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}understand sign language remains one of the major challenges in daily life. At }
\put(69.984,-181.26){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}present, conversations between them usually depend on human interpreters, written }
\put(69.984,-197.34){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}notes, or mobile typing, which are often slow and inconvenient. }
\put(69.984,-213.42){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The lack of accessible, real-time translation tools makes it difficult for people with }
\put(69.984,-229.5){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}hearing or speech disabilities to interact in workplaces, schools, hospitals, and other }
\put(69.984,-245.7){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}public spaces. }
\put(69.984,-261.81){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Therefore, the problem addressed in this project is to design and implement an AI-}
\put(69.984,-277.89){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}based system that can recognize sign language gestures through a webcam and }
\put(69.984,-293.97){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}convert them into readable text in real time. This system aims to minimize }
\put(69.984,-310.05){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}communication barriers, improve social inclusion, and enable effortless interaction }
\put(69.984,-326.13){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}between sign language users and non-signers. }
\put(69.984,-342.21){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-358.41){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}3.2 Goals and Objectives }
\put(69.984,-374.49){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The main goal of this project is to build an intelligent and user-friendly system that }
\put(69.984,-390.57){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}automatically converts sign language gestures into text using artificial intelligence }
\put(69.984,-406.65){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}and computer vision. }
\put(69.984,-422.73){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Specific Objectives: }
\put(83.424,-438.83){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Gesture Recognition: Develop a system that can accurately detect and classify }
\put(101.42,-455.03){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}hand gestures using deep learning algorithms like CNN. }
\put(83.424,-471.11){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Real-Time Translation: Ensure that gestures are processed instantly and }
\put(101.42,-487.19){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}converted into text without noticeable delay. }
\put(83.424,-503.27){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Accessibility: Design a simple and interactive interface that can be easily used }
\put(101.42,-519.35){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}by anyone, regardless of technical skills. }
\put(83.424,-535.43){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Accuracy and Efficiency: Achieve high accuracy in gesture prediction while }
\put(101.42,-551.51){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}maintaining smooth performance on standard devices. }
\put(83.424,-567.71){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Expandability: Make the system flexible so it can be extended later to include }
\put(101.42,-583.79){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}more gestures, languages, or even voice output. }
\put(69.984,-599.87){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Overall, this project aims to build a reliable, inclusive, and intelligent sign language }
\put(69.984,-615.98){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}recognition system that promotes better communication and understanding }
\put(69.984,-632.06){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}between all individuals. }
\put(69.984,-648.14){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-664.34){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}3.3 Scope and Major Constraints }
\put(69.984,-680.42){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The Sign Language to Text Language Conversion System focuses on identifying }
\put(69.984,-696.5){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}hand gestures from sign language and converting them into text using artificial }
\put(69.984,-712.58){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}intelligence. }
\put(69.984,-728.66){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Scope: }
\put(83.424,-744.736){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Real-time gesture detection and translation through a webcam. }
\put(83.424,-760.936){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Recognition of alphabets and basic words in sign language. }
\put(83.424,-777.016){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Simple and user-friendly web interface built with Flask. }
\put(83.424,-793.12){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• High accuracy using TensorFlow and Mediapipe-based models. }
\end{picture}
