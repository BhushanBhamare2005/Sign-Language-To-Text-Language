\put(282.07,-809.8){\fontsize{11.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-809.32){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(83.424,-57.03998){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Can be used in educational institutes, workplaces, hospitals, and social }
\put(101.42,-73.12){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}service centers to improve inclusivity. }
\put(69.984,-89.21997){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Constraints: }
\put(83.424,-105.3){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• The system requires a good-quality camera and stable lighting for accurate }
\put(101.42,-121.5){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}gesture detection. }
\put(83.424,-137.58){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Performance may vary depending on background conditions or hand }
\put(101.42,-153.66){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}movement speed. }
\put(83.424,-169.74){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• It focuses mainly on hand gestures, and does not currently process facial }
\put(101.42,-185.82){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}expressions or continuous sentence gestures. }
\put(83.424,-201.9){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Requires a computer with a webcam and basic internet connection for smooth }
\put(101.42,-218.1){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}functioning. }
\put(69.984,-234.18){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Even with these limitations, the system provides a strong foundation for developing }
