{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "app.py",
      "functions": {
        "app.py": {
          "includeFiles": "{sign_model.h5,hand_landmarker.task,labels.npy,test_model.py,templates/**,static/**}",
          "excludeFiles": "{dataset/**,ISL_Dataset/**,Greetings/**,waste/**,venv/**,.venv/**,myenv/**,uploads/**,model/**,isl_model.h5,isl_model.keras,isl_image_model.h5}",
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
