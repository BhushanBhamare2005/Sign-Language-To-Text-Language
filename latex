\put(69.984,-64.47998){\fontsize{21.96}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}Chapter 5 – Proposed Methodology }
\put(69.984,-84.17999){\fontsize{15.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-100.74){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791} }
\put(69.984,-116.82){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}5.1 System Architecture }
\put(69.984,-132.9){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The Sign Language to Text Language Conversion System follows a three-tier }
\put(69.984,-149.1){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}architecture, which includes three main layers — Input Layer, Processing Layer, }
\put(69.984,-165.18){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}and Output Layer. }
\put(69.984,-181.26){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}This structure ensures modularity, scalability, and efficient data processing. }
\put(69.984,-197.34){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} 1.Input Layer (Data Capture): }
\put(83.424,-213.42){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Acts as the interface between the user and the system. }
\put(83.424,-229.5){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Captures real-time hand gestures through a webcam. }
\put(83.424,-245.7){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Preprocesses the captured image frames (resizing, normalization, background }
\put(101.42,-261.81){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}reduction). }
\put(83.424,-277.89){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Implemented using OpenCV for real-time video capture and Mediapipe for }
\put(101.42,-293.97){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}hand landmark detection. }
\put(69.984,-310.05){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-326.13){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}2. Processing Layer (AI and Model Logic): }
\put(83.424,-342.21){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Core layer responsible for recognizing gestures using machine learning and }
\put(101.42,-358.41){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}deep learning algorithms. }
\put(83.424,-374.49){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Extracts hand landmarks and features, then classifies them using a }
\put(101.42,-390.57){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Convolutional Neural Network (CNN) model. }
\put(83.424,-406.65){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Utilizes TensorFlow for model training and prediction. }
\put(83.424,-422.73){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• The model converts gestures into corresponding letters or words based on }
\put(101.42,-438.83){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}trained datasets. }
\put(69.984,-455.03){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-471.11){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}3.Output Layer (Display and Interface): }
\put(83.424,-487.19){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Displays the recognized gesture as text on the screen. }
\put(83.424,-503.27){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Provides an easy-to-understand graphical interface using Flask web }
\put(101.42,-519.35){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}framework or GUI. }
\put(83.424,-535.43){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• Can also be extended to convert recognized text into speech for two-way }
\put(101.42,-551.51){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}communication. }
\put(69.984,-567.71){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-583.79){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}System Flow Overview: }
\put(83.424,-599.87){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}1. User performs gesture → }
\put(83.424,-615.98){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}2. Camera captures gesture → }
\put(83.424,-632.06){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}3. Mediapipe detects hand landmarks → }
\put(83.424,-648.14){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}4. CNN model predicts gesture → }
\put(83.424,-664.34){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}5. Text displayed on interface }
\put(69.984,-680.42){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}This architecture ensures real-time translation and seamless interaction for users. }
\put(69.984,-696.5){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-712.58){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-728.66){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(69.984,-744.736){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}5.2 Mathematical Modeling }
\put(69.984,-760.936){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}To mathematically represent the gesture recognition process: }
\put(69.984,-777.016){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Let: }
\put(83.424,-793.12){\fontsize{9.96}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}• S = Set of sign gestures }
