\put(65.424,-135.18){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(65.424,-161.22){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}1.3 Project Idea }
\put(65.424,-187.14){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The Sign Language to Text Language Conversion System is an AI-}
\put(65.424,-213.18){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}powered platform that detects hand gestures through a webcam and }
\put(65.424,-239.22){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}converts them into text instantly. The system uses Mediapipe for detecting }
\put(65.424,-265.29){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}hand landmarks, TensorFlow CNN models for gesture classification, and }
\put(65.424,-291.33){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}Flask for creating a simple and interactive user interface. }
\put(65.424,-317.37){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}When a user performs a sign, the camera captures it frame by frame. The }
\put(65.424,-343.41){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}model analyzes the gesture and matches it to a specific letter or word. The }
\put(65.424,-369.45){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}recognized sign is then displayed as text on the screen. }
\put(65.424,-395.37){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}This project aims to make real-time translation simple and accurate. It can }
\put(65.424,-421.41){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}be used in classrooms, workplaces, or even on mobile devices to help }
\put(65.424,-447.47){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}bridge communication gaps and promote inclusion in society. }
\put(65.424,-473.51){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791} }
\put(65.424,-499.55){\fontsize{14.04}{1}\usefont{T1}{cmr}{b}{n}\selectfont\color{color_29791}1.4 Proposed Solution }
\put(65.424,-525.59){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The proposed system uses artificial intelligence and computer vision }
\put(65.424,-551.63){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}techniques to translate sign language gestures into text automatically. The }
\put(65.424,-577.67){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}system is divided into three main modules: }
\put(51.984,-603.71){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}1. Input Module (Camera Capture): Captures hand gestures using a webcam }
\put(69.984,-629.66){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}in real time. }
\put(51.984,-655.7){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}2. Processing Module (Gesture Recognition): Uses Mediapipe and CNN }
\put(69.984,-681.74){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}algorithms to identify gestures from live video. }
\put(76.344,-707.78){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}1. Output Module (Text Display): Converts recognized gestures into }
\put(94.34,-733.816){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}corresponding text displayed on the screen. }
\put(65.424,-759.856){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}The system ensures real-time detection, accuracy, and ease of use. It }
\put(65.424,-785.92){\fontsize{14.04}{1}\usefont{T1}{cmr}{m}{n}\selectfont\color{color_29791}operates efficiently across different lighting conditions and backgrounds, }
\end{picture}
